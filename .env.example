# Copy this file to .env.local and fill in real values.
# See README.md for what each variable does and what happens if it's unset.

# Required for real video calls. If either is missing, the app runs in
# mock mode automatically (simulated rooms, no real Daily API calls, no crash).
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=your-subdomain.daily.co

# Postgres connection string (this project uses Neon). One-off mock calls work
# without it; persistent Rooms, identity/session state, saved people,
# notifications, diagnostics and durable attribution require it.
DATABASE_URL=

# Required when identity values are stored. It also signs the short-lived,
# server-verified traffic tokens used by production smoke/contract probes so
# public visitors cannot exclude themselves from demand reporting. Generate a
# long random secret; never reuse a password or commit the real value.
IDENTITY_HMAC_SECRET=

# Optional sign-in email delivery. When unset locally, one-time codes are
# written to the server log instead of being sent.
RESEND_API_KEY=
QWICKWORD_MAIL_FROM=Qwickword <sign-in@example.com>

# Production provider lifecycle and diagnostics verification.
DAILY_WEBHOOK_HMAC_SECRET=
DIAGNOSTICS_HMAC_SECRET=

# Vercel Cron authorization for diagnostics retention.
CRON_SECRET=
