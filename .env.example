# Copy this file to .env.local and fill in real values.
# See README.md for what each variable does and what happens if it's unset.

# Required for real video calls. If either is missing, the app runs in
# mock mode automatically (simulated rooms, no real Daily API calls, no crash).
DAILY_API_KEY=your-daily-api-key
DAILY_DOMAIN=your-subdomain.daily.co

# Optional. Postgres connection string (this project uses Neon) for recording
# call-creation stats. Unset = every write silently no-ops; nothing about
# running or testing the app depends on it. See src/lib/db.ts.
DATABASE_URL=
